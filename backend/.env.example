# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Database=cursinet_db;Username=user;Password=pass
 
# JWT
Jwt__Secret=your-secret-key-min-32-chars-long
Jwt__RefreshSecret=your-secret-key-min-32-chars-long
 
# SendGrid (emails)
SendGrid__ApiKey=SG.xxxxx
SendGrid__FromEmail=noreply@cursinet.com
SendGrid__FromName=Cursinet
SendGrid__BaseUrl=https://cursinet.vercel.app
 
# PayPal
PayPal__Enabled=true
PayPal__IsSandbox=false
PayPal__BaseUrl=https://api-m.paypal.com
PayPal__ClientId=your-production-client-id
PayPal__ClientSecret=your-production-secret
PayPal__WebhookId=your-webhook-id
